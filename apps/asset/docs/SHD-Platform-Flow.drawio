#FFFDE7;strokeColor=#F9A825;fontFamily=Sarabun;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1070" width="1820" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4. Asset — กระบวนการทรัพย์สินถาวร"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Asset (Fixed Asset System) — กระบวนการขึ้นทะเบียนและคิดค่าเสื่อมราคา&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Sarabun;fontSize=24;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1820" height="36" as="geometry"/></mxCell><mxCell id="c3" value="รายการทรัพย์สินเข้าระบบได้หลายช่องทาง ทุกรายการจาก OA และ ONEBOOK ต้องผ่านคิวตรวจสอบ (ตรวจซ้ำ เลือกหมวด แยกจำนวน) ก่อนสร้างเป็นทรัพย์สินฉบับร่าง หัวหน้าบัญชีอนุมัติแล้วจึงเริ่มคิดค่าเสื่อม รอบคำนวณรายเดือนต้องตรวจและล็อกก่อนส่งยอดไปลงสมุดรายวันของ ONEBOOK" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Sarabun;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1820" height="46" as="geometry"/></mxCell><mxCell id="c4" value="แหล่งข้อมูลเข้า" style="swimlane;horizontal=0;html=1;startSize=36;fillColor=#F5F5F5;strokeColor=#616161;swimlaneFillColor=#FFFFFF;fontFamily=Sarabun;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1820" height="160" as="geometry"/></mxCell><mxCell id="c5" value="คิวนำเข้า" style="swimlane;horizontal=0;html=1;startSize=36;fillColor=#FFF3E0;strokeColor=#E65100;swimlaneFillColor=#FFFFFF;fontFamily=Sarabun;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="1820" height="210" as="geometry"/></mxCell><mxCell id="c6" value="ทะเบียนทรัพย์สิน" style="swimlane;horizontal=0;html=1;startSize=36;fillColor=#FFF3E0;strokeColor=#E65100