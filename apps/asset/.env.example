# คัดลอกเป็น .env.local แล้วแก้ค่า (ไฟล์ .env.local ถูก gitignore ไว้ ไม่ขึ้น git)

# Postgres ก้อนเดียวกับ OA — Asset ใช้ schema fa (สร้างตารางเองอัตโนมัติตอนรันครั้งแรก)
DATABASE_URL=postgresql://localhost:5432/approve_dev

# เชื่อมกับ OA API (ฝั่ง server เท่านั้น)
OA_BASE_URL=http://localhost:3010
# กุญแจที่สร้างในหน้า "เชื่อมต่อระบบภายนอก" ของ OA (ต้องมี scope read + write)
OA_API_KEY=
# รหัสฟอร์ม OA ที่ถือเป็นรายการซื้อทรัพย์สิน
OA_TEMPLATE=PURCHASE

# DeepSeek — คลังความรู้ AI (ไม่ใส่ก็ใช้ระบบได้ แค่สร้าง/อัปเดตบทความใหม่ไม่ได้)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# เชื่อมกับระบบบัญชี ONEBOOK — ดึงบิลที่เป็นทรัพย์สิน (flow แบบ PEAK)
ONEBOOK_BASE_URL=https://onebook-gxyz.onrender.com
ONEBOOK_SYNC_KEY=

# เชื่อมกับระบบบัญชี PEAK (บัญชีหลัก) — ดึง Expense ที่ลงผังบัญชีสินทรัพย์ (ขึ้นต้น 12xx) มาขึ้นทะเบียน
# ขอ Connect ID + Application Code จากทีม PEAK (มี UAT ให้เทสต์) · PEAK ทำบัญชีค่าเสื่อมเอง เราแค่ดึงมาคิดค่าเสื่อมฝั่งเรา
# UAT base: http://peakengineapidev.azurewebsites.net  (production ขอจาก PEAK)
PEAK_BASE_URL=
PEAK_CONNECT_ID=
PEAK_APP_PASSWORD=
PEAK_USER_TOKEN=
# prefix บัญชีที่นับเป็นทรัพย์สิน (default 12) — ปรับได้ เช่น 121,122,124
PEAK_ASSET_ACCOUNT_PREFIXES=12
# สถานะเอกสาร Expense ที่ดึง (0=ทุกสถานะ · ดู enum ในเอกสาร PEAK) — ช่วยลดจำนวนที่ดึง/ประหยัดเครดิต
PEAK_EXPENSE_STATUS=0
# การเข้ารหัสลายเซ็น HMAC-SHA1: hex (ค่าเริ่มต้น ตามเอกสาร PEAK) หรือ base64
PEAK_SIG_ENCODING=hex
