# คัดลอกไฟล์นี้เป็น .env.local แล้วแก้ค่า

# ---------- ฐานข้อมูล (จำเป็น) ----------
# PostgreSQL connection string — ไม่ตั้งค่านี้ ระบบเปิดไม่ขึ้น
#
# ในเครื่องพัฒนา:  createdb approve_dev  แล้วใช้
#   DATABASE_URL=postgresql://localhost:5432/approve_dev
#
# Supabase: Project Settings → Database → Connection string → URI
#   ใช้ช่อง "Connection pooling" (พอร์ต 6543) ไม่ใช่ต่อตรงพอร์ต 5432
#   เลือก region ให้ตรงกับที่แอปรันอยู่ ไม่งั้นทุกคำสั่งต้องวิ่งข้ามทวีป
DATABASE_URL=

# จำนวน connection สูงสุดต่อ instance (ไม่ตั้ง = 8)
PGPOOL_MAX=

# ---------- ที่เก็บไฟล์แนบ (ไม่ตั้ง = เก็บบนดิสก์ตาม DATA_DIR) ----------
# ใช้ Supabase Storage อยู่ — พูดภาษาเดียวกับ Amazon S3 ย้ายทีหลังได้โดยไม่ต้องแก้โค้ด
#
# หาค่าได้ที่ Supabase → Storage → S3 Connection
#   S3_ENDPOINT  : https://<project-ref>.storage.supabase.co/storage/v1/s3
#   S3_REGION    : region ของโปรเจกต์ (ของเรา ap-southeast-1)
#   กุญแจสองตัว  : สร้างที่ Storage → S3 Access Keys
#
# (รับชื่อ AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY ได้เหมือนกัน — ชื่อนั้นเป็นของ
#  ไลบรารีฝั่ง Amazon แต่ชวนเข้าใจผิดว่าระบบต่อไปหา AWS ทั้งที่ไฟล์อยู่บน Supabase)
#
# ถังต้องตั้งเป็น private เท่านั้น — ไฟล์แนบคือเอกสารของบริษัท
# ระบบเสิร์ฟไฟล์ผ่าน /api/files/[id] ซึ่งตรวจสิทธิ์ก่อนส่งอยู่แล้ว
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# คำนำหน้าชื่อไฟล์ในถัง (ไม่ตั้ง = uploads/)
S3_PREFIX=

# ที่เก็บไฟล์แนบ ลายเซ็น และไฟล์สำรอง (ค่าเริ่มต้น: ./data)
# ไม่ใช่ที่เก็บฐานข้อมูลแล้ว — ฐานข้อมูลอยู่ที่ DATABASE_URL ข้างบน
DATA_DIR=./data

# ชื่อบริษัทที่แสดงบนหัวเอกสาร
NEXT_PUBLIC_COMPANY_NAME=บริษัท เอสเอชดี เทคโนโลยี จำกัด
NEXT_PUBLIC_COMPANY_NAME_EN=SHD TECHNOLOGY CO., LTD.

# รหัสผ่านเริ่มต้นของ user ที่ seed (ใช้ตอนรัน npm run seed)
SEED_PASSWORD=password123

# ---------- เชื่อมกับ Lark / Feishu (ไม่ตั้งก็ใช้ระบบได้ปกติ แค่ไม่มีแจ้งเตือน) ----------
# สร้าง Custom App ที่ Developer Console แล้วเอาค่ามาใส่
#   Lark สากล: https://open.larksuite.com   ·  Feishu จีน: https://open.feishu.cn
LARK_APP_ID=
LARK_APP_SECRET=
LARK_DOMAIN=https://open.larksuite.com

# ค่าจากหน้า Event Subscription / Message Card — ใช้ตรวจว่า callback มาจาก Lark จริง
# ต้องมีอย่างน้อยหนึ่งอย่าง ถึงจะกดอนุมัติจากการ์ดได้
LARK_VERIFICATION_TOKEN=
LARK_ENCRYPT_KEY=

# URL ของระบบนี้ที่เข้าถึงได้จากอินเทอร์เน็ต (Lark ยิง callback มาจากคลาวด์)
APP_BASE_URL=https://approve.company.co.th

# ภาษาของข้อความแจ้งเตือน เมื่อผู้รับยังไม่เคยเลือกภาษาในระบบ (th | en | zh)
LARK_NOTIFY_LOCALE=th

# ---------- เชื่อมกับระบบกลาง Central Login (OIDC) ----------
# ไม่ตั้ง = ใช้ล็อกอินด้วยอีเมล/รหัสผ่านในแอปเหมือนเดิม
SSO_ISSUER=https://sso.shd-technology.co.th
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_SCOPES=openid profile email

# ระบบกลางเป็นคนคุมสิทธิ์ (ค่าเริ่มต้น true) — ตั้ง false ถ้าอยากกำหนดสิทธิ์ในแอปเอง
SSO_CENTRAL_ROLES=true

# ยังให้ล็อกอินด้วยอีเมล/รหัสผ่านในแอปได้ไหม — false = เหลือแค่ปุ่ม Central Login (SSO เท่านั้น)
SSO_ALLOW_LOCAL_LOGIN=false

# จับคู่บทบาทของระบบกลาง (key) → role ในแอปนี้ (คั่นด้วยคอมมา)
# บทบาทมาตรฐาน Central Login: owner / admin / editor / viewer
SSO_ROLE_MAP=owner:ADMIN,admin:ADMIN,editor:USER,viewer:USER,manager:MANAGER,user:USER
SSO_DEFAULT_ROLE=USER

# ---------- สิทธิ์จากระบบกลาง (Central Login authz) ----------
# คีย์ของแอปที่ออกจากหน้า Credentials ของ Central Login — ใบเดียวใช้ได้ทั้ง /authz/* และ /directory/*
# ไม่ตั้งก็ได้ ระบบจะใช้ DIRECTORY_API_KEY แทน
CENTRAL_API_KEY=

# true = ให้ระบบกลางเป็นคนตัดสินว่าใครได้บทบาทไหน และปฏิเสธคนที่ไม่มีสิทธิ์ตั้งแต่ตอนล็อกอิน
# ปิดไว้เป็นค่าเริ่มต้นโดยตั้งใจ — เปิดก่อนตั้งบทบาทให้ครบทุกคนที่ระบบกลาง
# จะทำให้บางคนถูกลดสิทธิ์หรือเข้าไม่ได้ทันที (ดูตารางเทียบที่หน้า ผู้ดูแล → ระบบกลาง)
CENTRAL_AUTHZ=false

# เอา claim groups ไปจับคู่กับชื่อแผนกในระบบไหม (ต้องมีแผนกชื่อตรงกันอยู่แล้ว)
SSO_MAP_GROUPS=true

# ---------- ค้นรายชื่อจาก Central Login (ตั้งผู้อนุมัติด้วยชื่อ Lark) ----------
# ตัวสร้างฟอร์มจะให้พิมพ์ชื่อ Lark เลือกผู้อนุมัติ โดยดึงรายชื่อจากระบบกลาง (ที่ซิงก์จาก Lark ไว้)
#   CENTRAL_DIRECTORY_URL : ฐาน URL ของระบบกลาง (เว้นว่าง = ใช้ค่า SSO_ISSUER)
#   DIRECTORY_API_KEY     : API key ที่สร้างในระบบกลาง (แอปต้องมี scope directory:read:people)
CENTRAL_DIRECTORY_URL=https://sso.shd-technology.co.th
DIRECTORY_API_KEY=

# ---------- แจ้งเตือน Lark ผ่าน Central Login (Path B: DM ข้อความ + ลิงก์) ----------
# ถ้าไม่ตั้ง LARK_APP_ID/SECRET (ด้านบน) ระบบจะส่งแจ้งเตือนผ่าน /api/notify/lark ของระบบกลางแทน
# ใช้ค่าเดียวกับ directory ข้างบนได้เลย (CENTRAL_DIRECTORY_URL + DIRECTORY_API_KEY) — แค่:
#   • แอปในระบบกลางต้องมี scope feishu:notify:send + feishu:notify:direct
#   • ระบบกลางต้องตั้งค่า Lark (LARK_*/FEISHU_*) ให้ส่งได้จริง
#   • ต้องตั้ง APP_BASE_URL เพื่อใส่ลิงก์เข้าอนุมัติในข้อความ
# (จะ override แยกก็ได้ด้วย CENTRAL_NOTIFY_URL / NOTIFY_API_KEY)

# ---------- แจ้งเตือนทางอีเมล (ช่องทางสำรองเมื่อยังไม่ได้ตั้ง Lark) ----------
# ตั้ง Lark เมื่อไหร่ Lark ชนะเสมอ — การ์ดในแชทกดอนุมัติได้เลย อีเมลทำได้แค่พาเข้าเว็บ
# ไม่ตั้งเลย = ไม่มีการแจ้งเตือน คนต้องเปิดเว็บเช็คเอง
SMTP_HOST=
SMTP_PORT=587
# true เมื่อใช้พอร์ต 465 (TLS ตั้งแต่เชื่อมต่อ) · 587 ใช้ STARTTLS ไม่ต้องตั้ง
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# ผู้ส่งที่ผู้รับจะเห็น เช่น "ระบบขออนุมัติ <no-reply@shd-technology.co.th>"
SMTP_FROM=

# ---------- เขตเวลา ----------
# ต้องตั้งเสมอเมื่อ deploy — คอนเทนเนอร์ส่วนใหญ่เป็น UTC ซึ่งทำให้ช่วงเวลาทวงงาน
# วันที่เริ่มต้นของเอกสาร ช่วงมอบหมายอนุมัติแทน และเดือนในเลขที่เอกสาร คลาดไป 7 ชม.
TZ=Asia/Bangkok

# ---------- สำรองข้อมูลอัตโนมัติ ----------
# ที่เก็บสำเนา — ควรชี้ไปดิสก์อื่นหรือไดรฟ์ที่ sync ขึ้น cloud ไม่ใช่ดิสก์เดียวกับ data/
# ตอน deploy ต้องชี้ไปดิสก์ถาวรเสมอ ค่าเริ่มต้นนี้อยู่ในคอนเทนเนอร์ซึ่งถูกล้างทุกครั้งที่ deploy
BACKUP_DIR=./backups
# ปิดการสำรองอัตโนมัติได้ด้วย false (ยังสั่งเองจากหน้าผู้ดูแลได้)
BACKUP_AUTO=true
# สำรองใหม่เมื่อครั้งล่าสุดที่สำเร็จเก่ากว่ากี่ชั่วโมง
BACKUP_INTERVAL_HOURS=24
# เก็บสำเนาย้อนหลังกี่วัน (เก็บ 3 ชุดล่าสุดไว้เสมอ ต่อให้เลยอายุ)
BACKUP_RETENTION_DAYS=30
# ตั้งค่านี้ถ้าจะสั่งสำรองจาก cron ภายนอก:
#   curl -fsS -X POST -H "X-Backup-Token: $BACKUP_TOKEN" http://localhost:3001/api/backup/run
# BACKUP_TOKEN=

# ---------- เตือนงานค้างอัตโนมัติ ----------
REMINDER_ENABLED=true
# ค้างกี่วันถึงเริ่มทวงผู้อนุมัติ
REMINDER_AFTER_DAYS=3
# ค้างกี่วันถึงแจ้งหัวหน้าและผู้ยื่นด้วย
ESCALATE_AFTER_DAYS=7
# ส่งเฉพาะช่วงเวลานี้ (24 ชม.) — ไม่ทวงงานตอนกลางดึก
REMINDER_HOURS=9-18
# ข้ามเสาร์-อาทิตย์
REMINDER_SKIP_WEEKENDS=true

# ---------- กันการเดารหัสผ่าน ----------
# นับย้อนหลังกี่นาที
LOGIN_WINDOW_MINUTES=15
# ผิดได้กี่ครั้งต่อบัญชีในช่วงนั้น
LOGIN_MAX_PER_EMAIL=5
# ผิดได้กี่ครั้งต่อ IP ในช่วงนั้น (กันไล่ยิงหลายบัญชี)
LOGIN_MAX_PER_IP=20

# ---------- เลขที่เอกสารที่ออกจากคำขอ ----------
DOC_PREFIX_INVOICE=INV
DOC_PREFIX_CN=CN
DOC_PREFIX_DN=DN
DOC_PREFIX_RECEIPT=RC
DOC_PREFIX_OTHER=DOC

# ---------- เชื่อมต่อระบบภายนอก (ERP / บัญชี) ----------
# ปลายทางที่จะยิงข้อมูลไปเมื่อมีเหตุการณ์ (เว้นว่าง = ปิด)
WEBHOOK_URL=
# กุญแจสำหรับลงลายมือชื่อ payload ให้ปลายทางตรวจได้ว่ามาจากระบบนี้จริง
WEBHOOK_SECRET=
WEBHOOK_EVENTS=request.approved,request.rejected,document.issued
# กุญแจให้ระบบภายนอกมาดึงข้อมูลผ่าน /api/v1/... (เว้นว่าง = ปิด)
API_KEY=
