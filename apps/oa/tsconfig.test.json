{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "outDir": ".test-build",
    "rootDir": "src",
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/lib/**/*.ts"
  ]
}
